              "path": ["api", "v1", "quotations", "{{quotation_id}}", "proposals"]
            },
            "description": "Retorna quotation + rounds[] com proposals[] e items[] por fornecedor. Filtros: round_number, supplier_code, status."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "GET Listar pedidos",
          "request": {
            "method": "GET",
