        {
          "name": "GET PDF do pedido",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/purchase-orders/{{purchase_order_id}}/pdf",
              "host": ["{{base_url}}"],
